{
  "name": "2d-solar-system",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "data:orientation": "node scripts/fetch-orientation.ts",
    "data:planets": "node scripts/fetch-planets.ts",
    "data:moons": "node scripts/fetch-moons.ts",
    "data:small-bodies": "node scripts/fetch-small-bodies.ts",
    "data:ephemerides": "node scripts/fetch-ephemerides.ts",
    "data:asteroids": "node scripts/fetch-asteroids.ts",
    "data:spacecraft": "node scripts/fetch-spacecraft.ts",
    "data:missions": "node scripts/fetch-missions.ts",
    "data:satellites": "node scripts/fetch-satellites.ts",
    "data:stars": "node scripts/fetch-stars.ts",
    "data:galaxy": "node scripts/fetch-galaxy.ts",
    "data:all": "npm run data:orientation && npm run data:planets && npm run data:moons && npm run data:small-bodies && npm run data:ephemerides && npm run data:asteroids && npm run data:spacecraft && npm run data:missions && npm run data:satellites && npm run data:stars && npm run data:galaxy",
    "verify": "node scripts/verify-positions.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
